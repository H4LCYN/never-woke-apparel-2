<div class="under-construction_bkgd-wrppr"><img class="under-construction_bkgd-img" src="{{ 'logo.webp' | asset_url }}" alt="" sizes="(max-width: 1080px) 100vw, 1080px" loading="lazy" srcset="{{ 'logo-p-500.webp' | asset_url }} 500w, {{ 'logo-p-800.webp' | asset_url }} 800w, {{ 'logo.webp' | asset_url }} 1080w">
{{ section.settings.text_paragraph }}</div>
        <div class="padding-global padding-section-large">
          <div class="container-large">
            <div class="login_tabs is-password">
              <div class="login_form color-scheme-2 w-form">
                <h1 class="text-align-center">
{{ section.settings.text_heading }}
</h1>
                <p class="text-align-center text-style-allcaps">
{{ section.settings.text_paragraph }}
</p>
                {% form 'customer', return_to: '/', class: 'form_form' %}
<div class="form_field-wrapper"><input class="form_input is-alternate w-input" maxlength="256" name="contact[email]" data-name="Email" placeholder="Email" type="email" id="Email" required=""></div>
                  <div li-object="form.errors | default_errors" class="text-size-regular">{{ form.errors | default_errors }}</div>
                  <div class="hide w-embed"><input type="hidden" name="contact[accepts_marketing]" value="true"></div>
                  <div class="button-group"><input type="submit" data-wait="" class="button max-width-full is-alternate w-button" value="SIGN UP"></div>
                {% endform %}
                <div class="hide w-form-done">
                  <div>Thank you! Your submission has been received!</div>
                </div>
                <div class="hide w-form-fail">
                  <div>Oops! Something went wrong while submitting the form.</div>
                </div>
              </div>
            </div>
          </div>
        </div> {% schema %} {
    "tag": "section",
    "name": "Password",
    "class": "section_under-construction",
    "settings": [
        {
            "id": "text_paragraph",
            "type": "text",
            "label": "Paragraph",
            "default": "Lorem Ipsum"
        },
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Coming Soon"
        }
    ],
    "presets": [
        {
            "name": "Password",
            "category": "Liquify",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "password"
        ]
    }
} {% endschema %}