<div li-block="Product Details" class="product-header1_accordion-wrapper" {{ block.shopify_attributes }}>
                    
                
                    {% assign mf = product.metafields.custom.features %}
                    
                
                    {% assign feature_refs = mf.references | default: mf.value %}
                    
                
                    {% if feature_refs != blank %}    <div li-if="feature_refs != blank">
    
                  {% for feat in feature_refs %}    <div li-for="feat in feature_refs" class="product-header1_accordion">
                                    
                    
                            <div data-w-id="4c2f0778-a68f-edb7-e2e8-f37bb7bffb6b" class="product-header1_heading">
                      <div li-object="feat.dropdown" class="text-weight-semibold text-size-medium-2">{{ feat.dropdown }}</div>
                      <div class="product-header1_accordion-icon">
                        <div class="icon-embed-xsmall w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewbox="0 0 24 24" fill="none" preserveaspectratio="xMidYMid meet" aria-hidden="true" role="img">
                            <path d="M7.08691 9.02344C7.18774 9.02344 7.26471 9.05385 7.34277 9.13184L11.6455 13.459L11.999 13.8145L16.6816 9.13184C16.7593 9.05424 16.8257 9.03227 16.9062 9.03516C17.0005 9.0386 17.0819 9.07117 17.168 9.15723C17.246 9.23531 17.2764 9.31223 17.2764 9.41309C17.2763 9.51371 17.2458 9.59001 17.168 9.66797L12.249 14.5869C12.1949 14.6411 12.1522 14.667 12.124 14.6787C12.0885 14.6935 12.0486 14.7021 12 14.7021C11.9755 14.7021 11.9532 14.6993 11.9326 14.6953L11.875 14.6787L11.8223 14.6484C11.8015 14.634 11.7779 14.6138 11.751 14.5869L6.80664 9.64355C6.7328 9.56972 6.70662 9.50009 6.70996 9.40527C6.71375 9.29797 6.74977 9.2141 6.83203 9.13184C6.90996 9.05403 6.98632 9.02351 7.08691 9.02344Z" fill="currentColor" stroke="currentColor"></path>
                          </svg></div>
                      </div>
                    </div>
                            
                    
                            <div style="height:0px" class="product-header1_details">
                      <div class="margin-bottom margin-small">
                        <p li-object="feat.description | metafield_tag">{{ feat.description | metafield_tag }}</p>
                      </div>
                    </div>
                            
                  
                        </div>
{% endfor %}
                    </div>
{% endif %}
                    
              
